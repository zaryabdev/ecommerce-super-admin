# Clerk (same Clerk application/instance as the merchant Admin)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=


NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# Clerk user id of the single designated Super Admin (e.g. user_abc123).
# Access is denied to everyone when this is unset. Admin must validate the
# same value server-side on every privileged API request.
SUPER_ADMIN_CLERK_USER_ID=

# Base URL of the Admin app that hosts the privileged API (server-side only).
ADMIN_API_URL=http://localhost:4000
